# ---------------------------------------------------------------------------
# SAT - Superagentic Trading
# Every default below points at Robinhood Chain MAINNET and works with no
# configuration at all. One agent key (Kimi or OpenAI) switches the agent on.
# ---------------------------------------------------------------------------

# --- Agent (chat, plain-language rules and styles) ---
# Kimi is used when its key is set; otherwise OpenAI.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- X social radar (twitterapi.io). Off without a key. ---
TWITTERAPI_IO_KEY=
# Seconds between scans (each scan is two calls) and a hard daily call cap.
SOCIAL_SCAN_SECONDS=120
SOCIAL_MAX_CALLS_PER_DAY=1500
# Posts from accounts with at least this many followers raise alerts.
SOCIAL_ALERT_FOLLOWERS=10000

# --- Satellites Bot: automated X account posting the agent's best calls ---
# off | approve (drafts wait for a tap in BOT_ADMIN_CHAT_ID on Telegram) | auto
BOT_MODE=approve
# Long random string. Guards /api/bot/x/connect and /api/bot/status.
BOT_ADMIN_SECRET=
# Your Telegram chat id, where drafts arrive with Post / Skip buttons.
BOT_ADMIN_CHAT_ID=
BOT_MAX_CALLS_PER_DAY=8
BOT_MIN_GAP_MIN=45
# X developer app (OAuth 2.0, callback URL: <SAT_SITE_URL>/api/bot/x/callback)
X_CLIENT_ID=
X_CLIENT_SECRET=
SAT_SITE_URL=https://sathood.xyz

# --- Data source ---
# chain      = read Robinhood Chain mainnet directly (default)
# subgraph   = use a Uniswap v3 subgraph; requires RH_SUBGRAPH_URL
# synthetic  = offline fake market for UI development
SAT_DATA_SOURCE=chain
RH_SUBGRAPH_URL=

# --- Network (verified against docs.robinhood.com/chain/connecting) ---
# The public RPC is rate limited. For anything beyond local use, put a
# dedicated endpoint here (Alchemy, QuickNode, dRPC all support chain 4663).
RH_CHAIN_ID=4663
RH_CHAIN_NAME=Robinhood Chain
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
RH_NATIVE_SYMBOL=ETH
# Extra RPCs tried in order when the primary fails (comma separated).
RH_RPC_FALLBACK_URLS=
# Optional separate endpoint for heavy eth_getLogs history reads.
RH_LOGS_RPC_URL=
# What the browser's wallet is told to use. Keep this public: a paid key in
# RH_RPC_URL never leaves the server.
RH_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Trading ---
# Off by default. The app is read-only until this is "true". Even when on, the
# agent can only propose: every transaction is signed in your own wallet.
SAT_ENABLE_TRADING=false
# Uniswap v3 on Robinhood Chain. Verified on-chain: SwapRouter02.factory() and
# .WETH9() both match the official deployment.
RH_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
RH_WRAPPED_NATIVE=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- Guardrails applied to every proposed trade ---
SAT_MAX_TRADE_NATIVE=0.05
SAT_MAX_SLIPPAGE_BPS=100
SAT_MIN_LIQUIDITY_USD=10000
# Refuse any trade whose quoted price impact is above this percentage.
SAT_MAX_PRICE_IMPACT_PCT=15
# Fee on Uniswap Stock Token trades placed through SAT, taken by the router in
# the same transaction and sent to the fee wallet (funds SAT buybacks). Max 100.
SAT_FEE_BPS=50
SAT_FEE_RECIPIENT=0x10Acd70eeEb62dD762F1518D8aC687C77C484a76

# --- Wallet connect (RainbowKit) ---
# Free project id from https://cloud.reown.com. Enables mobile wallets and QR
# codes (WalletConnect). Without it, browser wallets (MetaMask, Rabby, Coinbase,
# any installed wallet) still work. Public by design: it ships to the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- SAT token and holder tiers ---
SAT_TOKEN_ADDRESS=0xbe3f794bfb99399a4ea9cd5acf08529eea6e718a
# USD value of SAT a wallet must hold for each tier.
SAT_TIER_HOLDER_USD=50
SAT_TIER_WHALE_USD=500

# --- Shared store (Upstash Redis REST) ---
# Lets every server instance and the worker share one set of fresh snapshots.
# Without it each instance keeps its own in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Telegram alerts ---
# Create a bot with @BotFather. Without a webhook secret the app polls the bot
# for /start messages, which is fine for local development. In production set a
# long random secret and run: npm run telegram:webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Public alpha channel (e.g. @sat_alpha) the bot posts big moves and the daily
# report to. The bot must be an admin of the channel.
TELEGRAM_ALPHA_CHAT_ID=
# Hour (UTC) the worker posts the daily flow report.
REPORT_POST_HOUR_UTC=14
# Used in alert links and the webhook address.
SAT_SITE_URL=https://sathood.xyz
